<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Progress photos (phase 3) live in files/photos and never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
